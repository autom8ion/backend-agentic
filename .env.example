# Copy to .env and adjust. These match `docker compose -f docker/docker-compose.yml up`
# running with its default host port mappings.

BACKEND_AGENTIC__REST__BASE_URL=http://localhost:8000
BACKEND_AGENTIC__GRAPHQL__ENDPOINT=http://localhost:8000/graphql

BACKEND_AGENTIC__DB__CONNECTIONS__DEFAULT=postgresql+psycopg://postgres:postgres@localhost:5432/orders

BACKEND_AGENTIC__KAFKA__BOOTSTRAP_SERVERS=localhost:19092
